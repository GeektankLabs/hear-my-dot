{
  "manifest_version": 3,
  "name": "Hear My Dot",
  "version": "0.3.1",
  "description": "Pause YouTube and Podverse, mute other tabs during ChatGPT audio, then restore owned changes.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://youtube.com/*",
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://podverse.fm/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "incognito": "not_allowed",
  "content_scripts": [
    {
      "matches": [
        "https://youtube.com/*",
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "media-controller.js",
        "youtube.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://podverse.fm/*"
      ],
      "js": [
        "media-controller.js",
        "podverse.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/active-16.png",
    "32": "icons/active-32.png",
    "48": "icons/active-48.png",
    "128": "icons/active-128.png"
  },
  "action": {
    "default_title": "Hear My Dot \u2014 initializing status. Click to open options.",
    "default_icon": {
      "16": "icons/ready-16.png",
      "24": "icons/ready-24.png",
      "32": "icons/ready-32.png"
    }
  }
}
